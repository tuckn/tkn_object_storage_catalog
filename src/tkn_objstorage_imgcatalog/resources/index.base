# Reference Obsidian Bases view; the CLI does not read this file.
filters:
  and:
    - 'file.ext == "md"'
    - 'assetId != null'
views:
  - type: cards
    name: Images
    image: note.cover
    cardSize: 180
    imageFit: contain
    order: [title, description, syncStatus, tags]
  - type: table
    name: Inventory
    order: [title, assetId, url, localPath, sourceAvailable, sha256]
